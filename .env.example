# Copy to .env and fill in. Never commit .env.
# Live orders need LIVE_TRADING=true AND the --live flag, and only after the Phase 5 gate.
LIVE_TRADING=false

# Upstox API: market data for research + paper trading (free)
# Easiest: the Analytics token (Upstox Developer Apps page): read-only, ~1 year validity, cannot place orders.
UPSTOX_ACCESS_TOKEN=
# Only needed for the daily OAuth flow (`mv upstox login-url` / `exchange-code`):
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback

# Groww Trade API (Phase 7: real orders)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=

# Claude API (Phase 6+)
ANTHROPIC_API_KEY=

# Notifications (optional): Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ops database (Phase 4+, optional; DuckDB is used until then)
DATABASE_URL=postgresql://market_view:market_view@localhost:5432/market_view
